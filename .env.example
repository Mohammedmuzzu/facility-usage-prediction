# Local development defaults use synthetic data; never expose development mode publicly.
FACILITY_ENV=development
# Required for production; generated hashes only, raw keys go in your secret manager.
# FACILITY_AUTH_FILE=/run/secrets/facility_auth
FACILITY_RATE_LIMIT=120
FACILITY_MAX_BODY_BYTES=16384
FACILITY_MAX_CONCURRENCY=4
FACILITY_MAX_DATA_AGE_HOURS=24
# FACILITY_RATE_DB=/tmp/facility-rate.sqlite3
# FACILITY_PROJECT_ROOT=/app
# FACILITY_DASHBOARD_TRUSTED_PROXY=true
